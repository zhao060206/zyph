{
  "name": "phototropic-live",
  "version": "1.0.0",
  "description": "Phototropic 摄影归档 · 带点赞与评论的在线站点",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/server.test.cjs tests/tones.test.mjs tests/season-scene.test.mjs",
    "analyze:tones": "node scripts/analyze-tones.mjs",
    "classify:tones": "node scripts/classify-tones-ai.mjs",
    "test:browser": "playwright test",
    "check": "node --check server.js && npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "photography",
    "gallery",
    "archive"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2"
  }
}
